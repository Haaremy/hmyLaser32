generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  nfcToken     String        @unique @default(uuid())
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  matches      MatchPlayer[]
}

/// ESP32-Server registriert sich selbst via POST /api/bridge/register.
/// `name` + `pin` werden vom ESP generiert; `pin` ist gleichzeitig der Access-Code
/// für Bridge-API-Calls und Settings-Edit im Web-UI.
model EspServer {
  id        String    @id @default(cuid())
  name      String    @unique
  pin       String    @unique
  lastSeen  DateTime?
  online    Boolean   @default(false)
  createdAt DateTime  @default(now())
  matches   Match[]
}

model Match {
  id              String        @id @default(cuid())
  serverId        String
  server          EspServer     @relation(fields: [serverId], references: [id])
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  mode            String?
  status          String        @default("active")
  settings        Json?
  players         MatchPlayer[]
  teams           Team[]
  hits            HitEvent[]
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  nfcToken  String
  teamId    String?
  team      Team?   @relation(fields: [teamId], references: [id])
  hits      Int     @default(0)
  deaths    Int     @default(0)
  points    Int     @default(0)
  shotsFired Int    @default(0)

  @@unique([matchId, nfcToken])
  @@index([matchId])
  @@index([userId])
}

model Team {
  id          String        @id @default(cuid())
  matchId     String
  match       Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  name        String
  color       String
  totalPoints Int           @default(0)
  players     MatchPlayer[]
}

/// Live-Feed-Quelle: jeder Hit-Event vom ESP wird hier persistiert.
/// Ermöglicht Live-Stream (WebSocket) + chronologische Re-Wiedergabe in der Match-Detail-Ansicht.
model HitEvent {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ts         DateTime @default(now())
  shooterNfc String?
  targetNfc  String?
  points     Int      @default(0)
  raw        Json?

  @@index([matchId, ts])
}
