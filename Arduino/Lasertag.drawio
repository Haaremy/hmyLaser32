        </mxCell>
        <mxCell id="s_init" value="AP + STA + Portal + ESP-NOW starten&#xa;optional Cloud-Registrierung mit Name/PIN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1010" y="280" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_collect" value="Clients sammeln&#xa;Discovery, Player-State, NFC und Hit-Events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
