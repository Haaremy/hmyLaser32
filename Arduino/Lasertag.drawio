        <mxCell id="m_active" value="MATCH_ACTIVE&#xa;Treffer werden ans Portal weitergeleitet&#xa;Match-Timer laeuft" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
