        </mxCell>
        <mxCell id="st_lobby" value="LOBBY&#xa;Countdown&#xa;Schuesse gesperrt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="920" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_active" value="ACTIVE&#xa;IR-Treffer, Respawn, lokales Ranking&#xa;MSG_HIT_EVENT / MSG_TABLE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="1040" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st_done" value="DONE&#xa;Ergebnisanzeige&#xa;danach zurueck IDLE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eadcf8;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1040" width="270" height="90" as="geometry" />
