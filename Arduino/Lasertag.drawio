        <mxCell id="client_header" value="Client / Spielerweste" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;fontSize=18;fontStyle=1;" vertex="1" parent="1">
