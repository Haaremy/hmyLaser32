        </mxCell>
        <mxCell id="c_init" value="Hardware + Funk initialisieren&#xa;OLED, LED, IR, ESP-NOW, Channel-Erkennung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="280" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_discovery" value="Discovery / Suche Mitspieler&#xa;ESP-NOW Broadcasts, Peers werden gesammelt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="400" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_identity" value="Identitaet aushandeln&#xa;Name, NEC-Command und Farbe aus Peer-Liste" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="520" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_decision" value="Frische Server-Phase vorhanden?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="650" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_server_mode" value="Server-Modus folgen&#xa;Server-Phase hat Vorrang&#xa;MSG_PHASE, MSG_TEAMS, MSG_PLAYER_CONFIG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="820" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_standalone_master" value="Standalone vorbereiten&#xa;Master Election: niedrigste bekannte Client-MAC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="980" width="440" height="80" as="geometry" />
        </mxCell>

