        <mxCell id="m_dist" value="MATCH_DISTRIBUTING&#xa;Match gestartet&#xa;Verteilzeit / Start-Countdown" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
